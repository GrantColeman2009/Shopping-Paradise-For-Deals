<%- include('../partials/header', { title: (product.id ? 'Edit' : 'New') + ' product', cartCount, seller }) %>

<div class="auth-box wide">
  <h1><%= product.id ? 'Edit product' : 'Add a product' %></h1>
  <p class="muted">Enter your item price and four shipping rates separately — shoppers everywhere see the item price on listings and pay shipping as a separate line at checkout. Nothing is ever hidden in the price.</p>
  <% if (typeof error !== 'undefined' && error) { %><p class="error"><%= error %></p><% } %>
  <form action="<%= product.id ? '/seller/products/' + product.id + '/edit' : '/seller/products' %>" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Product name <input type="text" name="name" value="<%= product.name || '' %>" required></label>
    <label>Description <textarea name="description" rows="4"><%= product.description || '' %></textarea></label>
    <label>Category
      <select name="category">
        <% ['electronics','home','fashion','sports','other'].forEach(function(c) { %>
          <option value="<%= c %>" <%= product.category === c ? 'selected' : '' %>><%= c.charAt(0).toUpperCase() + c.slice(1) %></option>
        <% }) %>
      </select>
    </label>
    <label>Where was this product made?
      <select name="origin_country_code">
        <% countries.forEach(function(c) { %>
          <option value="<%= c[0] %>" <%= (product.origin_country_code || (seller && seller.country_code) || 'CA') === c[0] ? 'selected' : '' %>><%= flagOf(c[0]) %> <%= c[1] %></option>
        <% }) %>
      </select>
      <span class="muted small">Shown to shoppers as "Made in …" before they buy. A Canadian company can sell a product made anywhere.</span>
    </label>
    <div class="two-col">
      <label>Item price (CAD) <input type="number" name="price" step="0.01" min="0" value="<%= product.price_cents != null ? (product.price_cents/100).toFixed(2) : '' %>" required></label>
      <label>Shipping cost — Standard, Canada &amp; USA (CAD) <input type="number" name="shipping_cost" step="0.01" min="0" value="<%= product.shipping_cost_cents != null ? (product.shipping_cost_cents/100).toFixed(2) : '0' %>" required></label>
    </div>
    <div class="two-col">
      <label>Shipping cost — Standard, other countries (CAD) <input type="number" name="intl_shipping" step="0.01" min="0" value="<%= product.intl_shipping_cents != null ? (product.intl_shipping_cents/100).toFixed(2) : '0' %>" required>
        <span class="muted small">Charged at checkout to buyers outside Canada &amp; the USA.</span>
      </label>
      <label>Shipping cost — Express, Canada &amp; USA (CAD) <input type="number" name="express_ca_us" step="0.01" min="0" value="<%= product.express_ca_us_cents != null && product.express_ca_us_cents > 0 ? (product.express_ca_us_cents/100).toFixed(2) : '' %>" placeholder="leave blank = standard rate">
        <span class="muted small">Set this explicitly — express is never calculated from the standard rate.</span>
      </label>
      <label>Shipping cost — Express, other countries (CAD) <input type="number" name="express_intl" step="0.01" min="0" value="<%= product.express_intl_cents != null && product.express_intl_cents > 0 ? (product.express_intl_cents/100).toFixed(2) : '' %>" placeholder="leave blank = standard rate"></label>
      <label>Stock <input type="number" name="stock" min="0" value="<%= product.stock != null ? product.stock : '10' %>" required></label>
    </div>
    <div class="two-col">
      <label>Image URL <input type="url" name="image_url" value="<%= product.image_url || '' %>" placeholder="https://…"></label>
    </div>
    <p class="muted">Your orders ship via <strong><%= carrierName(carrierKeyForCountry((seller && seller.country_code) || 'CA')) %></strong> — your country's national postal service. This is set automatically and shown to shoppers before they buy. Your item price never includes shipping — it is charged to the buyer at checkout for every destination.</p>
    <button type="submit"><%= product.id ? 'Save changes' : 'List product' %></button>
  </form>
</div>

<%- include('../partials/footer') %>
