<%- include('../partials/header', { title: 'Seller login', cartCount, seller }) %>

<div class="auth-box">
  <h1>Seller login</h1>
  <% if (typeof error !== 'undefined' && error) { %><p class="error"><%= error %></p><% } %>
  <form action="/seller/login" method="post">
    <label>Email <input type="email" name="email" required></label>
    <label>Password <input type="password" name="password" required></label>
    <button type="submit">Log in</button>
  </form>
  <p class="muted small">New here? <a href="/seller/signup">Open your shop</a></p>
</div>

<%- include('../partials/footer') %>
