<%- include('partials/header', { title: 'Order confirmed', cartCount, seller }) %>

<div class="confirmation">
  <% if (order.status === 'paid') { %>
  <h1>🎉 Order confirmed!</h1>
  <p>Thank you, <%= order.buyer_name %>. Your order <strong>#<%= order.id %></strong> is on its way.</p>
  <p class="muted">A confirmation was sent to <%= order.buyer_email %>. (Demo mode — no email actually sent.)</p>
  <% } else { %>
  <h1>⏳ Payment pending</h1>
  <p>Your order <strong>#<%= order.id %></strong> is waiting for payment. If you just paid, give it a moment and refresh this page.</p>
  <% } %>

  <h2>Order summary</h2>
  <table class="cart-table">
    <thead><tr><th>Product</th><th>Qty</th><th>Price</th></tr></thead>
    <tbody>
      <% items.forEach(function(i) { %>
        <tr><td><%= i.name %></td><td><%= i.qty %></td><td><%= fmt(i.unit_price_cents * i.qty) %></td></tr>
      <% }) %>
    </tbody>
  </table>
  <% const isIntl = order.dest_country_code && order.dest_country_code !== 'CA' && order.dest_country_code !== 'US'; %>
  <% if (isIntl) { %>
  <p>Shipping (<%= order.ship_option === 'express' ? 'Express' : 'Standard' %> international): <strong><%= fmt(order.shipping_cents) %></strong></p>
  <% } %>
  <p><% if (order.status === 'paid') { %>Total paid:<% } else { %>Order total:<% } %> <strong><%= fmt(order.total_cents) %></strong> <% if (!isIntl) { %><span class="free-ship">FREE shipping</span><% } %></p>
  <% if (order.insured_cents > 0) { %>
  <p class="muted small">Insured up to <%= fmt(order.insured_cents) %> (carrier maximum coverage). Shipping insurance claims are handled by our support team — contact Adam via the <a href="/help">Help centre</a>.</p>
  <% } %>
  <p class="muted small">Ship to: <%= order.address %><% if (order.dest_country_code) { %>, <%= order.dest_country_code %><% } %></p>
  <p><a class="btn" href="/products">Keep shopping</a></p>
</div>

<%- include('partials/footer') %>
