<%- include('partials/header', { title: 'Platform stats', cartCount, seller }) %>

<h1>Platform stats <span class="muted small">(demo admin view)</span></h1>

<div class="stat-grid">
  <div class="stat"><span class="stat-num"><%= stats.sellers %></span><span class="stat-label">Sellers</span></div>
  <div class="stat"><span class="stat-num"><%= stats.products %></span><span class="stat-label">Products listed</span></div>
  <div class="stat"><span class="stat-num"><%= stats.orders %></span><span class="stat-label">Orders</span></div>
  <div class="stat"><span class="stat-num"><%= fmt(stats.gross) %></span><span class="stat-label">Gross volume</span></div>
  <div class="stat"><span class="stat-num"><%= fmt(stats.fees) %></span><span class="stat-label">4% fees collected</span></div>
  <div class="stat"><span class="stat-num"><%= fmt(stats.sellers * 1400) %></span><span class="stat-label">Subscription revenue/mo</span></div>
</div>

<h2>Seller payouts</h2>
<p>Seller payouts: 14th and 28th of each month at 10:00 AM PST.</p>
<p><strong>Next payout: <%= nextPayout %></strong></p>

<h2>Revenue by month</h2>
<% if (revenueByMonth.length === 0) { %>
  <p class="muted">No revenue yet.</p>
<% } else { %>
  <table class="cart-table">
    <thead><tr><th>Month</th><th>Orders</th><th>Gross volume</th><th>Fees (4%)</th></tr></thead>
    <tbody>
      <% revenueByMonth.forEach(function(r) { %>
        <tr><td><%= r.month %></td><td><%= r.orders %></td><td><%= fmt(r.gross) %></td><td><%= fmt(r.fees) %></td></tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<h2>Top sellers by sales volume</h2>
<% if (topSellers.length === 0) { %>
  <p class="muted">No sales yet.</p>
<% } else { %>
  <table class="cart-table">
    <thead><tr><th>Seller</th><th>Sales volume</th><th>Orders</th></tr></thead>
    <tbody>
      <% topSellers.forEach(function(s) { %>
        <tr><td><%= s.business_name %></td><td><%= fmt(s.sales) %></td><td><%= s.orders %></td></tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<h2>Recent orders</h2>
<% if (recent.length === 0) { %>
  <p class="muted">No orders yet.</p>
<% } else { %>
  <table class="cart-table">
    <thead><tr><th>#</th><th>Buyer</th><th>Total</th><th>Fee (4%)</th><th>Status</th><th>Date</th></tr></thead>
    <tbody>
      <% recent.forEach(function(o) { %>
        <tr><td><a href="/orders/<%= o.id %>"><%= o.id %></a></td><td><%= o.buyer_name %></td><td><%= fmt(o.total_cents) %></td><td><%= fmt(o.platform_fee_cents) %></td><td><%= o.status %></td><td><%= o.created_at %></td></tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<h2>Amazon Associates settings</h2>
<form action="/admin/settings" method="post" class="inline-form">
  <label>Associates tag ID <input type="text" name="amazon_tag" value="<%= amazonTag %>" size="30"></label>
  <button type="submit" class="secondary">Save</button>
</form>

<h2>Brand-Name Deals</h2>
<% if (editDeal) { %>
  <h3>Edit deal #<%= editDeal.id %></h3>
  <form action="/admin/deals/<%= editDeal.id %>" method="post" class="stacked-form">
    <label>Title <input type="text" name="title" value="<%= editDeal.title %>" required></label>
    <label>Brand <input type="text" name="brand" value="<%= editDeal.brand %>"></label>
    <label>Price (CAD) <input type="number" name="price" step="0.01" min="0" value="<%= (editDeal.price_cents / 100).toFixed(2) %>" required></label>
    <label>Image URL <input type="text" name="image_url" value="<%= editDeal.image_url %>" size="50"></label>
    <label>Affiliate URL <input type="text" name="affiliate_url" value="<%= editDeal.affiliate_url %>" size="50"></label>
    <button type="submit">Save changes</button>
    <a class="secondary" href="/admin">Cancel</a>
  </form>
<% } else { %>
  <h3>Add a deal</h3>
  <form action="/admin/deals" method="post" class="stacked-form">
    <label>Title <input type="text" name="title" required></label>
    <label>Brand <input type="text" name="brand"></label>
    <label>Price (CAD) <input type="number" name="price" step="0.01" min="0" required></label>
    <label>Image URL <input type="text" name="image_url" size="50"></label>
    <label>Affiliate URL <input type="text" name="affiliate_url" placeholder="#" size="50"></label>
    <button type="submit">Add deal</button>
  </form>
<% } %>

<% if (deals.length === 0) { %>
  <p class="muted">No deals listed.</p>
<% } else { %>
  <table class="cart-table">
    <thead><tr><th>#</th><th>Title</th><th>Brand</th><th>Price</th><th>Affiliate URL</th><th></th></tr></thead>
    <tbody>
      <% deals.forEach(function(d) { %>
        <tr>
          <td><%= d.id %></td>
          <td><%= d.title %></td>
          <td><%= d.brand %></td>
          <td><%= fmt(d.price_cents) %></td>
          <td class="muted small"><%= d.affiliate_url %></td>
          <td>
            <a href="/admin?edit=<%= d.id %>">Edit</a>
            <form action="/admin/deals/<%= d.id %>/delete" method="post" class="inline-form" onsubmit="return confirm('Delete this deal?')">
              <button type="submit" class="danger linklike">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('partials/footer') %>
