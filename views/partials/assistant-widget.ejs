<% // Floating support assistant. Always labelled as an AI assistant, never as a human. %>
<button id="ai-help-fab" aria-label="Open help chat" title="Help — AI assistant">💬 Help</button>
<div id="ai-help-panel" hidden role="dialog" aria-label="AI support assistant">
  <div class="ai-help-head">
    <div>
      <strong>Support Assistant</strong>
      <span class="ai-badge">AI — automated, not a human</span>
    </div>
    <button id="ai-help-close" aria-label="Close help chat">✕</button>
  </div>
  <div id="ai-help-msgs"></div>
  <div id="ai-help-chips"></div>
  <form id="ai-help-form">
    <input id="ai-help-input" type="text" placeholder="Ask about orders, shipping, selling…" maxlength="500" autocomplete="off">
    <button type="submit">Send</button>
  </form>
  <p class="ai-help-note">Need a person? <a href="/support/new">File a support ticket</a></p>
</div>
<script src="/js/assistant-widget.js" defer></script>
