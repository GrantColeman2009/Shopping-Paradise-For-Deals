<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>Shopping Paradise For Deals</title>
  <meta name="description" content="<%= typeof description !== 'undefined' && description ? description : 'Shopping Paradise For Deals — honest prices; shipping and taxes shown separately at checkout. A 100% Canadian owned marketplace.' %>">
  <meta property="og:site_name" content="Shopping Paradise For Deals">
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title + ' — ' : '' %>Shopping Paradise For Deals">
  <meta property="og:description" content="<%= typeof description !== 'undefined' && description ? description : 'Honest prices — shipping and taxes shown separately at checkout. A 100% Canadian owned marketplace.' %>">
  <% if (typeof ogImage !== 'undefined' && ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } %>
  <link rel="stylesheet" href="/style.css">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/">🛒 Shopping Paradise <span>For Deals</span></a>
      <span class="ca-owned" title="This marketplace is owned and operated in Canada">🍁 100% Canadian Owned &amp; Operated</span>
      <nav class="main-nav">
        <a href="/">Home</a>
        <a href="/products">Shop</a>
        <a href="/deals">Brand-Name Deals</a>
        <a href="/pricing">Sell</a>
        <% if (typeof seller !== 'undefined' && seller) { %>
          <a href="/seller/dashboard">Dashboard</a>
          <span class="nav-user">Hi, <%= seller.business_name %></span>
        <% } else { %>
          <a href="/seller/login">Seller Login</a>
        <% } %>
        <a class="cart-link" href="/cart">Cart (<%= typeof cartCount !== 'undefined' ? cartCount : 0 %>)</a>
        <a href="/help">Help</a>
      </nav>
    </div>
  </header>
  <main class="container">
